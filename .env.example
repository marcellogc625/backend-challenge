# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (usado pelo Docker Compose, NestJS e MikroORM)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wagering
POSTGRES_TEST_DB=wagering_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wagering

# AWS / LocalStack SQS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_INTEGRATION_EVENTS_QUEUE_NAME=integration-events.fifo
SQS_WAGER_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions-dlq.fifo
SQS_INTEGRATION_EVENTS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/integration-events.fifo

# Workers & Retry Policies
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
PENDING_REF_POLL_INTERVAL_MS=1000
PENDING_REF_MAX_ATTEMPTS=8
