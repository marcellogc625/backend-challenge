          "expression": "((kind = ANY (ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying])) AND (reference_external_transaction_id IS NOT NULL)) OR (kind <> ALL (ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying]))",
